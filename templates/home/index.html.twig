                    </div>
                    <p class="skill-note" data-default="Sélectionnez une technologie pour afficher le détail."
                       data-fr-default="Sélectionnez une technologie pour afficher le détail."
                       data-en-default="Select a technology to see the details.">
                        Sélectionnez une technologie pour afficher le détail.
                    </p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>


{# ============ CONTACT ============ #}
