{% endblock %}

{% block javascripts %}
<script>
/* Écrans qui défilent dans les mockups de l'accueil : un changement toutes les 3,2 s, en fondu.
   Pause au survol d'un mockup, onglet masqué ou préférence « réduire les animations ». */
(function () {
    var groups = [].slice.call(document.querySelectorAll('[data-cycle]'));
    if (!groups.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var step = 0, paused = false;
    function render() {
        groups.forEach(function (g) {
            var imgs = g.querySelectorAll('img');
            if (imgs.length < 2) return;
            var cur = (step + parseInt(g.getAttribute('data-offset') || '0', 10)) % imgs.length;
            for (var k = 0; k < imgs.length; k++) imgs[k].classList.toggle('is-on', k === cur);
        });
    }
    document.querySelectorAll('.project-media').forEach(function (m) {
        m.addEventListener('mouseenter', function () { paused = true; });
        m.addEventListener('mouseleave', function () { paused = false; });
    });
    setInterval(function () { if (paused || document.hidden) return; step++; render(); }, 3200);
})();

/* Hero mobile : « Mon histoire » ouvre une fenêtre avec les quatre paragraphes (le texte vient de .hero-story,
   donc il suit le choix FR / EN). Se ferme d'un clic n'importe où, avec Échap ou en glissant vers le bas. */
(function () {
    var open = document.getElementById('storyOpen'), sheet = document.getElementById('storySheet');
    var story = document.querySelector('.hero-story'), body = document.getElementById('storyBody');
    if (!open || !sheet || !story || !body) return;
    var panel = sheet.querySelector('.story-sheet__panel'), startY = null;
    function fill() {
        body.innerHTML = '';
        [].forEach.call(story.querySelectorAll(':scope > p'), function (p, i) {
            var c = document.createElement('p');
            c.innerHTML = p.innerHTML;
            if (i === 0) c.className = 'is-lead';
            body.appendChild(c);
        });
    }
    function show() {
        fill(); sheet.hidden = false;
        requestAnimationFrame(function () { sheet.classList.add('is-open'); });
        document.documentElement.style.overflow = 'hidden';
        panel.focus();
    }
    function hide() {
        sheet.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        setTimeout(function () { sheet.hidden = true; }, 320);
        open.focus();
    }
    open.addEventListener('click', show);
    sheet.addEventListener('click', hide);   /* un simple clic n'importe où referme la fenêtre */
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !sheet.hidden) hide(); });
    panel.addEventListener('touchstart', function (e) { startY = panel.scrollTop <= 0 ? e.touches[0].clientY : null; }, { passive: true });
    panel.addEventListener('touchend', function (e) {
        if (startY !== null && e.changedTouches[0].clientY - startY > 90) hide();
        startY = null;
    }, { passive: true });
    window.matchMedia('(min-width: 768px)').addEventListener('change', function (m) { if (m.matches && !sheet.hidden) hide(); });
})();

/* Parcours (mobile) : seul le titre est visible ; un clic déplie la carte, « Réduire » ou une autre carte la range.
   Sur grand écran, toutes les cartes restent ouvertes et le script ne fait rien. */
(function () {
    var cards = [].slice.call(document.querySelectorAll('#parcours [data-tl]'));
    if (!cards.length) return;
    var mq = window.matchMedia('(max-width: 767.98px)');
    function setOpen(c, o) {
        c.classList.toggle('is-open', o);
        var h = c.querySelector('.tl-head');
        if (mq.matches) h.setAttribute('aria-expanded', o ? 'true' : 'false');
    }
    function prepare() {
        cards.forEach(function (c) {
            var h = c.querySelector('.tl-head');
            if (mq.matches) { h.setAttribute('role', 'button'); h.setAttribute('tabindex', '0'); h.setAttribute('aria-expanded', c.classList.contains('is-open') ? 'true' : 'false'); }
            else { h.removeAttribute('role'); h.removeAttribute('tabindex'); h.removeAttribute('aria-expanded'); c.classList.remove('is-open'); }
        });
    }
    function toggle(c) {
        var o = !c.classList.contains('is-open');
        cards.forEach(function (x) { if (x !== c) setOpen(x, false); });
        setOpen(c, o);
        if (o) setTimeout(function () { var r = c.getBoundingClientRect(); if (r.top < 80) window.scrollBy({ top: r.top - 90, behavior: 'smooth' }); }, 60);
    }
    cards.forEach(function (c) {
        var h = c.querySelector('.tl-head');
        h.addEventListener('click', function () { if (mq.matches) toggle(c); });
        h.addEventListener('keydown', function (e) { if (mq.matches && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); toggle(c); } });
        c.querySelector('.tl-less').addEventListener('click', function () { setOpen(c, false); });
    });
    if (mq.addEventListener) mq.addEventListener('change', prepare);
    prepare();
})();
</script>
{% endblock %}
