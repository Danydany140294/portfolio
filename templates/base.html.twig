<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Dany Dauberton — Développeur web junior PHP & Symfony{% endblock %}</title>
    <meta name="description" content="{% block description %}Développeur web junior à Montpellier. PHP, Symfony, Twig, MySQL et UX. Applications web utiles, modernes et agréables à utiliser.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <script>
      // Évite le flash de thème
      (function(){var t=localStorage.getItem('theme')||'dark';document.documentElement.dataset.theme=t;})();
    </script>
</head>
<body>
<div class="scroll-progress"><span id="scrollBar"></span></div>

<header class="site-header" id="siteHeader">
    <div class="header-inner">
        <a class="brand" href="{{ path('app_home') }}">
            <span class="brand-dot"></span> Dany<span class="brand-muted">Dauberton</span>
        </a>

        <nav class="nav-desktop" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}#accueil">Accueil</a>
            <a href="{{ path('app_home') }}#projets">Projets</a>
            <a href="{{ path('app_home') }}#parcours">Parcours</a>
            <a href="{{ path('app_home') }}#competences">Compétences</a>
            <a href="{{ path('app_home') }}#contact">Contact</a>
        </nav>

        <div class="header-actions">
            <a class="icon-btn" href="https://github.com/Danydany140294" target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.29-1.71-1.29-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.42.36.8 1.08.8 2.18v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
            </a>
            <a class="icon-btn" href="https://www.linkedin.com/in/dany-dauberton/" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.75V21h-4v-5.6c0-1.34-.03-3.07-1.9-3.07-1.9 0-2.19 1.46-2.19 2.97V21h-4z"/></svg>
            </a>
            <button class="icon-btn" id="themeToggle" aria-label="Changer de thème">
                <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
            <a class="btn btn-ghost cv-btn" href="{{ asset('cv/CV_Dany.pdf') }}" download>Télécharger mon CV</a>
            <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
                <span></span><span></span>
            </button>
        </div>
    </div>
</header>

<div class="mobile-panel" id="mobilePanel" hidden>
    <nav aria-label="Navigation mobile">
        <a href="{{ path('app_home') }}#accueil"><span>01</span>Accueil</a>
        <a href="{{ path('app_home') }}#projets"><span>02</span>Projets</a>
        <a href="{{ path('app_home') }}#parcours"><span>03</span>Parcours</a>
        <a href="{{ path('app_home') }}#competences"><span>04</span>Compétences</a>
        <a href="{{ path('app_home') }}#contact"><span>05</span>Contact</a>
    </nav>
    <div class="mobile-panel-footer">
        <a class="btn btn-primary" href="{{ asset('cv/CV_Dany.pdf') }}" download>Télécharger mon CV</a>
        <div class="mobile-socials">
            <a href="https://github.com/Danydany140294" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/dany-dauberton/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </div>
</div>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <p class="footer-name">Dany Dauberton</p>
        <p class="footer-note">Développeur web  — Montpellier / Castelnau-le-Lez</p>
        <div class="footer-links">
            <a href="https://github.com/Danydany140294" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/dany-dauberton/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="mailto:dany140294@hotmail.com">Email</a>
        </div>
        <p class="footer-copy">© {{ "now"|date("Y") }} — Conçu et développé avec Symfony.</p>
    </div>
</footer>

<script src="{{ asset('js/app.js') }}" defer></script>
{% block javascripts %}

<script src="https://cdn.jsdelivr.net/npm/embla-carousel@8/embla-carousel.umd.min.js"></script>

{% endblock %}
</body>
</html>
