{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} — Étude de cas | Dany Dauberton{% endblock %}
{% block description %}{{ project.description }}{% endblock %}

{% block body %}
<section class="case-hero grain">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="blob {{ project.accent == 'coral' ? 'blob-coral' : 'blob-violet' }}" aria-hidden="true"></div>

    <div class="container">
        <a class="back-link" href="{{ path('app_home') }}#projets">← Retour aux projets</a>

        <div class="case-head">
            <div>
                <div class="project-top">
                    <span class="mono muted">{{ project.index }}</span>
                    <span class="chip chip-{{ project.accent }}">{{ project.category }}</span>
                </div>
                <h1>{{ project.title }}</h1>
                <p class="hero-desc">{{ project.description }}</p>
            </div>
            <a class="btn btn-ghost" href="{{ project.githubUrl }}" target="_blank" rel="noopener">Voir le code</a>
        </div>

        <div class="case-cover embla" data-embla>
            <div class="embla__viewport">
                <div class="embla__container">
                    {% for img in project.images %}
                        <div class="embla__slide">
                            <button type="button" class="embla__slide-btn" data-lightbox-open data-index="{{ loop.index0 }}" aria-label="Agrandir l'image {{ loop.index }} du projet {{ project.title }}" style="all:unset; display:block; width:100%; height:100%; cursor:zoom-in;">
                                <img src="{{ asset('images/' ~ img) }}" alt="Capture d'écran {{ loop.index }} du projet {{ project.title }}" width="1440" height="960" loading="{{ loop.first ? 'eager' : 'lazy' }}">
                            </button>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if project.images is defined and project.images|length > 1 %}
                <button class="embla__btn embla__btn--prev" type="button" aria-label="Image précédente">←</button>
                <button class="embla__btn embla__btn--next" type="button" aria-label="Image suivante">→</button>
                <div class="embla__dots"></div>
            {% endif %}
        </div>

        <!-- Lightbox : agrandissement plein écran au clic sur une capture -->
        <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Aperçu de l'image du projet">
            <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fermer l'aperçu">✕</button>
            {% if project.images is defined and project.images|length > 1 %}
                <button type="button" class="lightbox__btn lightbox__btn--prev" data-lightbox-prev aria-label="Image précédente">←</button>
                <button type="button" class="lightbox__btn lightbox__btn--next" data-lightbox-next aria-label="Image suivante">→</button>
            {% endif %}
            <figure class="lightbox__figure">
                <img class="lightbox__img" id="lightboxImg" src="" alt="">
                {% if project.images is defined and project.images|length > 1 %}
                    <figcaption class="lightbox__counter" id="lightboxCounter"></figcaption>
                {% endif %}
            </figure>
        </div>

        <dl class="case-meta">
            <div class="glass"><dt class="eyebrow">Rôle</dt><dd>{{ project.role }}</dd></div>
            <div class="glass"><dt class="eyebrow">Durée</dt><dd>{{ project.duree }}</dd></div>
            <div class="glass"><dt class="eyebrow">Stack</dt><dd>{{ project.tags|join(' · ') }}</dd></div>
        </dl>

        {% if project.demoAccounts is defined %}
            <div class="glass demo-accounts" style="margin-top:28px; padding:24px;">
                <p class="eyebrow">Tester l'application</p>
                <h3 style="margin-top:10px; font-size:1.3rem;">Accès de démonstration</h3>
                <p class="muted" style="margin-top:8px; font-size:.9rem;">
                    Environnement de démo avec données fictives — connectez-vous avec le rôle de votre choix pour explorer l'interface.
                </p>
                <div class="demo-accounts-grid" style="margin-top:20px; display:grid; gap:14px;">
                    {% for acc in project.demoAccounts %}
                        <div class="demo-account-row" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; padding:14px 16px; border-radius:12px; background:var(--surface); border:1px solid var(--border);">
                            <span class="chip chip-{{ project.accent }}" style="flex-shrink:0;">{{ acc.role }}</span>
                                                        <div style="flex:1; min-width:180px; display:flex; flex-direction:column; gap:6px;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <p class="mono" style="font-size:.85rem;">{{ acc.email }}</p>
                                    <button type="button" class="copy-field-btn" data-value="{{ acc.email }}" title="Copier l'identifiant" style="border:none; background:transparent; cursor:pointer; color:var(--muted); padding:2px;">
                                        📋
                                    </button>
                                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <p class="mono muted" style="font-size:.78rem;">{{ acc.password }}</p>
                                    <button type="button" class="copy-field-btn" data-value="{{ acc.password }}" title="Copier le mot de passe" style="border:none; background:transparent; cursor:pointer; color:var(--muted); padding:2px;">
                                        📋
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <a class="btn btn-primary" href="{{ project.url }}login" target="_blank" rel="noopener" style="margin-top:20px;">
                    Ouvrir DP Services ↗
                </a>
            </div>
        {% endif %}
    </div>
</section>

<section id="etude" class="section">
    <div class="container case-grid">
        <div class="reveal">
            <p class="eyebrow">Contexte</p>
            <h2>Le point de départ</h2>
            <p class="muted">{{ project.context }}</p>

            <p class="eyebrow mt-lg">Objectifs</p>
            <ul class="bullets">
                {% for o in project.objectifs %}<li>{{ o }}</li>{% endfor %}
            </ul>
        </div>

        <div>
            <div class="reveal">
                <p class="eyebrow">Démarche</p>
                <h2>Du cadrage à la mise en ligne</h2>
            </div>
            <div class="steps">
                {% for d in project.demarche %}
                    <div class="glass step reveal" data-delay="{{ loop.index0 * 70 }}">
                        <span class="mono accent">0{{ loop.index }}</span>
                        <h3>{{ d.titre }}</h3>
                        <p class="muted">{{ d.texte }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>


{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/embla-carousel@8/embla-carousel.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var root = document.querySelector('[data-embla]');
            if (!root || typeof EmblaCarousel === 'undefined') return;

            var viewport = root.querySelector('.embla__viewport');
            var embla = EmblaCarousel(viewport, { loop: true, align: 'start' });

            var prevBtn = root.querySelector('.embla__btn--prev');
            var nextBtn = root.querySelector('.embla__btn--next');
            var dotsWrap = root.querySelector('.embla__dots');

            if (prevBtn) prevBtn.addEventListener('click', function () { embla.scrollPrev(); });
            if (nextBtn) nextBtn.addEventListener('click', function () { embla.scrollNext(); });

            if (dotsWrap) {
                var slideCount = embla.scrollSnapList().length;
                var dots = [];

                for (var i = 0; i < slideCount; i++) {
                    (function (index) {
                        var dot = document.createElement('button');
                        dot.type = 'button';
                        dot.className = 'embla__dot';
                        dot.setAttribute('aria-label', 'Aller à l\'image ' + (index + 1));
                        dot.addEventListener('click', function () { embla.scrollTo(index); });
                        dotsWrap.appendChild(dot);
                        dots.push(dot);
                    })(i);
                }

                var updateDots = function () {
                    var selected = embla.selectedScrollSnap();
                    dots.forEach(function (dot, index) {
                        dot.classList.toggle('embla__dot--selected', index === selected);
                    });
                };

                embla.on('select', updateDots);
                embla.on('init', updateDots);
            }

            // Garde le carrousel et la lightbox synchronisés dans les deux sens
            var lightboxIndexRef = { current: 0 };
            embla.on('select', function () {
                lightboxIndexRef.current = embla.selectedScrollSnap();
                if (typeof syncLightboxToIndex === 'function') {
                    syncLightboxToIndex(lightboxIndexRef.current);
                }
            });

            document.querySelectorAll('.copy-field-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    navigator.clipboard.writeText(btn.dataset.value).then(function () {
                        var original = btn.textContent;
                        btn.textContent = '✓';
                        setTimeout(function () { btn.textContent = original; }, 1200);
                    });
                });
            });

            // ---------- Lightbox : agrandissement plein écran au clic ----------
            var lightbox = document.getElementById('lightbox');
            if (!lightbox) return;

            var lightboxImg = document.getElementById('lightboxImg');
            var lightboxCounter = document.getElementById('lightboxCounter');
            var slideButtons = Array.prototype.slice.call(root.querySelectorAll('[data-lightbox-open]'));
            var images = slideButtons.map(function (btn) {
                var img = btn.querySelector('img');
                return { src: img.currentSrc || img.src, alt: img.alt };
            });
            var currentIndex = 0;

            var renderLightboxImage = function () {
                lightboxImg.classList.remove('is-loaded');
                lightboxImg.src = images[currentIndex].src;
                lightboxImg.alt = images[currentIndex].alt;
                if (lightboxCounter) {
                    lightboxCounter.textContent = (currentIndex + 1) + ' / ' + images.length;
                }
            };

            lightboxImg.addEventListener('load', function () {
                lightboxImg.classList.add('is-loaded');
            });

            var openLightbox = function (index) {
                currentIndex = index;
                renderLightboxImage();
                lightbox.classList.add('open');
                lightbox.setAttribute('aria-hidden', 'false');
                document.body.classList.add('lightbox-open');
            };

            var closeLightbox = function () {
                lightbox.classList.remove('open');
                lightbox.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('lightbox-open');
            };

            var showNext = function () {
                currentIndex = (currentIndex + 1) % images.length;
                renderLightboxImage();
                embla.scrollTo(currentIndex);
            };

            var showPrev = function () {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                renderLightboxImage();
                embla.scrollTo(currentIndex);
            };

            // Expose une fonction pour que la sélection du carrousel puisse mettre
            // à jour l'image affichée si la lightbox est déjà ouverte
            window.syncLightboxToIndex = function (index) {
                if (!lightbox.classList.contains('open')) return;
                currentIndex = index;
                renderLightboxImage();
            };

            slideButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openLightbox(parseInt(btn.dataset.index, 10));
                });
            });

            var closeBtn = lightbox.querySelector('[data-lightbox-close]');
            if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

            var prevBtn2 = lightbox.querySelector('[data-lightbox-prev]');
            var nextBtn2 = lightbox.querySelector('[data-lightbox-next]');
            if (prevBtn2) prevBtn2.addEventListener('click', showPrev);
            if (nextBtn2) nextBtn2.addEventListener('click', showNext);

            lightbox.addEventListener('click', function (e) {
                if (e.target === lightbox) closeLightbox();
            });

            document.addEventListener('keydown', function (e) {
                if (!lightbox.classList.contains('open')) return;
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') showNext();
                if (e.key === 'ArrowLeft') showPrev();
            });
        });
    </script>
{% endblock %}
