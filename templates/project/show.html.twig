{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} — Étude de cas | Dany Dauberton{% endblock %}
{% block description %}{{ project.description }}{% endblock %}

{% block body %}
{% set isPortrait = (project.imageFormat|default('landscape')) == 'portrait' %}
<section class="case-hero grain">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="blob {{ project.accent == 'coral' ? 'blob-coral' : 'blob-violet' }}" aria-hidden="true"></div>

    <div class="container">
        <a class="back-link" href="{{ path('app_home') }}#projets" data-fr="← Retour aux projets" data-en="← Back to projects">← Retour aux projets</a>

        <div class="case-head">
            <div>
                <div class="project-top">
                    <span class="mono muted">{{ project.index }}</span>
                    <span class="chip chip-{{ project.accent }}"
                          data-fr="{{ project.category }}"
                          data-en="{{ project.category_en|default(project.category) }}">{{ project.category }}</span>
                </div>
                <h1>{{ project.title }}</h1>
                <p class="hero-desc"
                   data-fr="{{ project.intro|default(project.description) }}"
                   data-en="{{ project.intro_en|default(project.description_en|default(project.description)) }}">{{ project.intro|default(project.description) }}</p>
            </div>
            {% if project.githubUrl %}
                <a class="btn btn-ghost" href="{{ project.githubUrl }}" target="_blank" rel="noopener" data-fr="Voir le code" data-en="View the code">Voir le code</a>
            {% endif %}
        </div>

        <div class="case-cover embla{{ isPortrait ? ' case-cover--portrait' : ' case-cover--laptop' }}" data-embla>
            <div class="embla__viewport">
                <div class="embla__container">
                    {% for img in project.images %}
                        {% if isPortrait %}
                            {# Captures verticales : un téléphone par slide, avec sa légende #}
                            {% set capFr = project.imageAlts[loop.index0]|default('Capture d\'écran ' ~ loop.index ~ ' du projet ' ~ project.title) %}
                            {% set capEn = project.imageAlts_en[loop.index0]|default('Screenshot ' ~ loop.index ~ ' of the ' ~ project.title ~ ' project') %}
                            <div class="embla__slide">
                                <figure class="case-phone">
                                    <button type="button" class="case-phone__btn" data-lightbox-open data-index="{{ loop.index0 }}" aria-label="Agrandir l'image {{ loop.index }} du projet {{ project.title }}"
                                            data-fr-aria-label="Agrandir l'image {{ loop.index }} du projet {{ project.title }}"
                                            data-en-aria-label="Enlarge image {{ loop.index }} of the {{ project.title }} project">
                                        <span class="case-phone__frame">
                                            <img src="{{ asset('images/' ~ img) }}" alt="{{ capFr }}"
                                                 data-fr-alt="{{ capFr }}"
                                                 data-en-alt="{{ capEn }}"
                                                 width="750" height="1300" loading="{{ loop.index0 < 4 ? 'eager' : 'lazy' }}">
                                        </span>
                                    </button>
                                    <figcaption class="case-phone__cap">
                                        <span class="mono accent">0{{ loop.index }}</span>
                                        <span data-fr="{{ capFr }}" data-en="{{ capEn }}">{{ capFr }}</span>
                                    </figcaption>
                                </figure>
                            </div>
                        {% else %}
                            <div class="embla__slide">
                                <div class="laptop-wrap">
                                    <div class="laptop">
                                      <div class="laptop__display">
                                        <div class="laptop__bar" aria-hidden="true">
                                            <span></span><span></span><span></span>
                                            <em class="laptop__url">{{ (project.url|default(''))|replace({'https://': '', 'http://': ''})|trim('/', 'right') }}</em>
                                        </div>
                                        <button type="button" class="embla__slide-btn laptop__screen" data-lightbox-open data-index="{{ loop.index0 }}" aria-label="Agrandir l'image {{ loop.index }} du projet {{ project.title }}"
                                                data-fr-aria-label="Agrandir l'image {{ loop.index }} du projet {{ project.title }}"
                                                data-en-aria-label="Enlarge image {{ loop.index }} of the {{ project.title }} project">
                                            <img src="{{ asset('images/' ~ img) }}" alt="Capture d'écran {{ loop.index }} du projet {{ project.title }}"
                                                 data-fr-alt="Capture d'écran {{ loop.index }} du projet {{ project.title }}"
                                                 data-en-alt="Screenshot {{ loop.index }} of the {{ project.title }} project"
                                                 width="1440" height="810" loading="{{ loop.first ? 'eager' : 'lazy' }}">
                                        </button>
                                      </div>
                                    </div>
                                    <div class="laptop__base" aria-hidden="true"></div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {% if project.images is defined and project.images|length > 1 %}
                <button class="embla__btn embla__btn--prev" type="button" aria-label="Image précédente" data-fr-aria-label="Image précédente" data-en-aria-label="Previous image">←</button>
                <button class="embla__btn embla__btn--next" type="button" aria-label="Image suivante" data-fr-aria-label="Image suivante" data-en-aria-label="Next image">→</button>
                <div class="embla__dots"></div>
            {% endif %}
        </div>

        {% if not isPortrait and project.mediaNote is defined %}
            <p class="case-media-note muted"
               data-fr="{{ project.mediaNote }}"
               data-en="{{ project.mediaNote_en|default(project.mediaNote) }}">{{ project.mediaNote }}</p>
        {% endif %}

        <!-- Lightbox : agrandissement plein écran au clic sur une capture -->
        <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Aperçu de l'image du projet"
             data-fr-aria-label="Aperçu de l'image du projet" data-en-aria-label="Project image preview">
            <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fermer l'aperçu"
                    data-fr-aria-label="Fermer l'aperçu" data-en-aria-label="Close preview">✕</button>
            {% if project.images is defined and project.images|length > 1 %}
                <button type="button" class="lightbox__btn lightbox__btn--prev" data-lightbox-prev aria-label="Image précédente"
                        data-fr-aria-label="Image précédente" data-en-aria-label="Previous image">←</button>
                <button type="button" class="lightbox__btn lightbox__btn--next" data-lightbox-next aria-label="Image suivante"
                        data-fr-aria-label="Image suivante" data-en-aria-label="Next image">→</button>
            {% endif %}
            <figure class="lightbox__figure">
                <img class="lightbox__img" id="lightboxImg" src="" alt="">
                {% if project.images is defined and project.images|length > 1 %}
                    <figcaption class="lightbox__counter" id="lightboxCounter"></figcaption>
                {% endif %}
            </figure>
        </div>

        <dl class="case-meta">
            <div class="glass"><dt class="eyebrow" data-fr="Rôle" data-en="Role">Rôle</dt><dd data-fr="{{ project.role }}" data-en="{{ project.role_en|default(project.role) }}">{{ project.role }}</dd></div>
            <div class="glass"><dt class="eyebrow" data-fr="Durée" data-en="Duration">Durée</dt><dd data-fr="{{ project.duree }}" data-en="{{ project.duree_en|default(project.duree) }}">{{ project.duree }}</dd></div>
            <div class="glass"><dt class="eyebrow">Stack</dt><dd>{{ project.tags|join(' · ') }}</dd></div>
        </dl>

        {% if project.demoAccounts is defined %}
            <div class="glass demo-accounts" style="margin-top:28px; padding:24px;">
                <p class="eyebrow" data-fr="Tester l'application" data-en="Try the application">Tester l'application</p>
                <h3 style="margin-top:10px; font-size:1.3rem;" data-fr="Accès de démonstration" data-en="Demo access">Accès de démonstration</h3>
               <p class="muted" style="margin-top:8px; font-size:.9rem;"
                  data-fr="Les données sont fictives. Choisissez un rôle et connectez-vous pour tester l'application."
                  data-en="The data is fictitious. Choose a role and log in to try the application.">
    Les données sont fictives. Choisissez un rôle et connectez-vous pour tester l'application.
</p>
                <div class="demo-accounts-grid" style="margin-top:20px; display:grid; gap:14px;">
                    {% for acc in project.demoAccounts %}
                        <div class="demo-account-row" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; padding:14px 16px; border-radius:12px; background:var(--surface); border:1px solid var(--border);">
                            <span class="chip chip-{{ project.accent }}" style="flex-shrink:0;"
                                  data-fr="{{ acc.role }}"
                                  data-en="{{ acc.role_en|default(acc.role) }}">{{ acc.role }}</span>
                                                        <div style="flex:1; min-width:180px; display:flex; flex-direction:column; gap:6px;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <p class="mono" style="font-size:.85rem;">{{ acc.email }}</p>
                                    <button type="button" class="copy-field-btn" data-value="{{ acc.email }}" title="Copier l'identifiant"
                                            data-fr-title="Copier l'identifiant" data-en-title="Copy the username"
                                            style="border:none; background:transparent; cursor:pointer; color:var(--muted); padding:2px;">
                                        📋
                                    </button>
                                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <p class="mono muted" style="font-size:.78rem;">{{ acc.password }}</p>
                                    <button type="button" class="copy-field-btn" data-value="{{ acc.password }}" title="Copier le mot de passe"
                                            data-fr-title="Copier le mot de passe" data-en-title="Copy the password"
                                            style="border:none; background:transparent; cursor:pointer; color:var(--muted); padding:2px;">
                                        📋
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <a class="btn btn-primary" href="{{ project.url }}login" target="_blank" rel="noopener" style="margin-top:20px;"
                   data-fr="Ouvrir DP Services ↗" data-en="Open DP Services ↗">
                    Ouvrir DP Services ↗
                </a>
            </div>
        {% elseif isPortrait %}
            <div class="glass demo-note" style="margin-top:28px; padding:24px;">
                <p class="eyebrow" data-fr="À propos des captures" data-en="About the screenshots">À propos des captures</p>
                <p class="muted" style="margin-top:10px; font-size:.92rem; max-width:46rem;"
                   data-fr="DANY AI manipule des données personnelles (CV, candidatures, e-mails). Il n'y a donc pas de démo en ligne : ces captures viennent d'une version de démonstration isolée, avec un profil fictif et aucune clé réelle."
                   data-en="DANY AI handles personal data (CV, applications, emails). There is therefore no online demo: these screenshots come from an isolated demo version, with a fictional profile and no real keys.">DANY AI manipule des données personnelles (CV, candidatures, e-mails). Il n'y a donc pas de démo en ligne : ces captures viennent d'une version de démonstration isolée, avec un profil fictif et aucune clé réelle.</p>
            </div>
        {% endif %}
    </div>
</section>

<section id="etude" class="section">
    <div class="container case-grid">
        <div class="reveal">
            <p class="eyebrow" data-fr="Contexte" data-en="Context">Contexte</p>
            <h2 data-fr="Le point de départ" data-en="The starting point">Le point de départ</h2>
            <p class="muted"
               data-fr="{{ project.context }}"
               data-en="{{ project.context_en|default(project.context) }}">{{ project.context }}</p>

            <p class="eyebrow mt-lg" data-fr="Objectifs" data-en="Goals">Objectifs</p>
            <ul class="bullets">
                {% for o in project.objectifs %}<li data-fr="{{ o }}" data-en="{{ project.objectifs_en[loop.index0]|default(o) }}">{{ o }}</li>{% endfor %}
            </ul>
        </div>

        <div>
            <div class="reveal">
                <p class="eyebrow" data-fr="Démarche" data-en="Approach">Démarche</p>
                <h2 data-fr="Du cadrage à la mise en ligne" data-en="From scoping to launch">Du cadrage à la mise en ligne</h2>
            </div>
            <div class="steps">
                {% for d in project.demarche %}
                    <div class="glass step reveal" data-delay="{{ loop.index0 * 70 }}">
                        <span class="mono accent">0{{ loop.index }}</span>
                        <h3 data-fr="{{ d.titre }}" data-en="{{ d.titre_en|default(d.titre) }}">{{ d.titre }}</h3>
                        <p class="muted" data-fr="{{ d.texte }}" data-en="{{ d.texte_en|default(d.texte) }}">{{ d.texte }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% if project.fonctionnalites is defined %}
{# Icônes (trait fin) dans l'ordre des 9 cartes #}
{% set featureIcons = [
    '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>',
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
    '<rect x="3" y="4" width="5" height="16" rx="1.5"/><rect x="10" y="4" width="5" height="10" rx="1.5"/><rect x="17" y="4" width="4" height="13" rx="1.5"/>',
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
    '<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4"/>',
    '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>',
    '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
    '<path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/>'
] %}
<section id="fonctionnalites" class="section">
    <div class="container">
        <div class="reveal features-head">
            <p class="eyebrow" data-fr="Fonctionnalités" data-en="Features">Fonctionnalités</p>
            <h2 data-fr="Ce que fait l'application" data-en="What the app does">Ce que fait l'application</h2>
            {% if project.slogan is defined %}
                <p class="features-lead"
                   data-fr="{{ project.slogan }}"
                   data-en="{{ project.slogan_en|default(project.slogan) }}">{{ project.slogan }}</p>
            {% endif %}
        </div>
        <div class="features-grid">
            {% for f in project.fonctionnalites %}
                <article class="glass feature reveal" data-delay="{{ (loop.index0 % 3) * 60 }}">
                    <div class="feature__top">
                        <span class="feature__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{{ featureIcons[loop.index0]|raw }}</svg>
                        </span>
                        <span class="feature__num mono">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</span>
                    </div>
                    <h3 data-fr="{{ f.titre }}" data-en="{{ f.titre_en|default(f.titre) }}">{{ f.titre }}</h3>
                    <p data-fr="{{ f.texte }}" data-en="{{ f.texte_en|default(f.texte) }}">{{ f.texte }}</p>
                </article>
            {% endfor %}
        </div>
        {% if project.limites is defined %}
            <div class="glass features-limits reveal">
                <span class="features-limits__label mono" data-fr="Garde-fous" data-en="Safeguards">Garde-fous</span>
                <ul>
                    {% for l in project.limites %}
                        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span data-fr="{{ l }}" data-en="{{ project.limites_en[loop.index0]|default(l) }}">{{ l }}</span></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
</section>
{% endif %}

{% if project.resultats is defined or project.apprentissages is defined %}
<section id="bilan" class="section">
    <div class="container case-grid">
        {% if project.resultats is defined %}
        <div>
            <div class="reveal">
                <p class="eyebrow" data-fr="Résultats" data-en="Results">Résultats</p>
                <h2 data-fr="Ce que ça donne" data-en="The outcome">Ce que ça donne</h2>
            </div>
            <div class="case-results">
                {% for r in project.resultats %}
                    <div class="glass case-result reveal" data-delay="{{ loop.index0 * 70 }}">
                        <strong class="accent">{{ r.valeur }}</strong>
                        <span class="muted" data-fr="{{ r.label }}" data-en="{{ r.label_en|default(r.label) }}">{{ r.label }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% if project.apprentissages is defined %}
        <div class="reveal">
            <p class="eyebrow" data-fr="Apprentissages" data-en="Takeaways">Apprentissages</p>
            <h2 data-fr="Ce que j'en retiens" data-en="What I took from it">Ce que j'en retiens</h2>
            <ul class="bullets">
                {% for a in project.apprentissages %}<li data-fr="{{ a }}" data-en="{{ project.apprentissages_en[loop.index0]|default(a) }}">{{ a }}</li>{% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</section>
{% endif %}

{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/embla-carousel@8/embla-carousel.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var root = document.querySelector('[data-embla]');
            if (!root || typeof EmblaCarousel === 'undefined') return;

            var viewport = root.querySelector('.embla__viewport');
            var embla = EmblaCarousel(viewport, { loop: true, align: 'start' });

            var prevBtn = root.querySelector('.embla__btn--prev');
            var nextBtn = root.querySelector('.embla__btn--next');
            var dotsWrap = root.querySelector('.embla__dots');

            if (prevBtn) prevBtn.addEventListener('click', function () { embla.scrollPrev(); });
            if (nextBtn) nextBtn.addEventListener('click', function () { embla.scrollNext(); });

            if (dotsWrap) {
                var slideCount = embla.scrollSnapList().length;
                var dots = [];

                for (var i = 0; i < slideCount; i++) {
                    (function (index) {
                        var dot = document.createElement('button');
                        dot.type = 'button';
                        dot.className = 'embla__dot';
                        dot.setAttribute('aria-label', 'Aller à l\'image ' + (index + 1));
                        dot.addEventListener('click', function () { embla.scrollTo(index); });
                        dotsWrap.appendChild(dot);
                        dots.push(dot);
                    })(i);
                }

                var updateDots = function () {
                    var selected = embla.selectedScrollSnap();
                    dots.forEach(function (dot, index) {
                        dot.classList.toggle('embla__dot--selected', index === selected);
                    });
                };

                embla.on('select', updateDots);
                embla.on('init', updateDots);
            }

            // Garde le carrousel et la lightbox synchronisés dans les deux sens
            var lightboxIndexRef = { current: 0 };
            embla.on('select', function () {
                lightboxIndexRef.current = embla.selectedScrollSnap();
                if (typeof syncLightboxToIndex === 'function') {
                    syncLightboxToIndex(lightboxIndexRef.current);
                }
            });

            document.querySelectorAll('.copy-field-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    navigator.clipboard.writeText(btn.dataset.value).then(function () {
                        var original = btn.textContent;
                        btn.textContent = '✓';
                        setTimeout(function () { btn.textContent = original; }, 1200);
                    });
                });
            });

            // ---------- Lightbox : agrandissement plein écran au clic ----------
            var lightbox = document.getElementById('lightbox');
            if (!lightbox) return;

            var lightboxImg = document.getElementById('lightboxImg');
            var lightboxCounter = document.getElementById('lightboxCounter');
            var slideButtons = Array.prototype.slice.call(root.querySelectorAll('[data-lightbox-open]'));
            var images = slideButtons.map(function (btn) {
                var img = btn.querySelector('img');
                return { src: img.currentSrc || img.src, alt: img.alt };
            });
            var currentIndex = 0;

            var renderLightboxImage = function () {
                lightboxImg.classList.remove('is-loaded');
                lightboxImg.src = images[currentIndex].src;
                lightboxImg.alt = images[currentIndex].alt;
                if (lightboxCounter) {
                    lightboxCounter.textContent = (currentIndex + 1) + ' / ' + images.length;
                }
            };

            lightboxImg.addEventListener('load', function () {
                lightboxImg.classList.add('is-loaded');
            });

            var openLightbox = function (index) {
                currentIndex = index;
                renderLightboxImage();
                lightbox.classList.add('open');
                lightbox.setAttribute('aria-hidden', 'false');
                document.body.classList.add('lightbox-open');
            };

            var closeLightbox = function () {
                lightbox.classList.remove('open');
                lightbox.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('lightbox-open');
            };

            var showNext = function () {
                currentIndex = (currentIndex + 1) % images.length;
                renderLightboxImage();
                embla.scrollTo(currentIndex);
            };

            var showPrev = function () {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                renderLightboxImage();
                embla.scrollTo(currentIndex);
            };

            // Expose une fonction pour que la sélection du carrousel puisse mettre
            // à jour l'image affichée si la lightbox est déjà ouverte
            window.syncLightboxToIndex = function (index) {
                if (!lightbox.classList.contains('open')) return;
                currentIndex = index;
                renderLightboxImage();
            };

            slideButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openLightbox(parseInt(btn.dataset.index, 10));
                });
            });

            var closeBtn = lightbox.querySelector('[data-lightbox-close]');
            if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

            var prevBtn2 = lightbox.querySelector('[data-lightbox-prev]');
            var nextBtn2 = lightbox.querySelector('[data-lightbox-next]');
            if (prevBtn2) prevBtn2.addEventListener('click', showPrev);
            if (nextBtn2) nextBtn2.addEventListener('click', showNext);

            lightbox.addEventListener('click', function (e) {
                if (e.target === lightbox) closeLightbox();
            });

            document.addEventListener('keydown', function (e) {
                if (!lightbox.classList.contains('open')) return;
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') showNext();
                if (e.key === 'ArrowLeft') showPrev();
            });
        });
    </script>
{% endblock %}
